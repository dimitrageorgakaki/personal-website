---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, readingTime } from '../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary}>
  <article>
    <p class="back"><a href="/blog/">← All posts</a></p>
    <div class="meta">{formatDate(post.data.date)} · {readingTime(post.body)}</div>
    <h1>{post.data.title}</h1>
    <div class="body"><Content /></div>
  </article>
</Base>
<style>
  article { margin-top: var(--space-6); }
  .meta { color: var(--muted); font-size: 14px; margin-bottom: var(--space-2); }
  h1 { margin-bottom: var(--space-5); }
  .body :global(h2) { margin: var(--space-6) 0 var(--space-3); }
  .body :global(h3) { margin: var(--space-5) 0 var(--space-2); }
  .body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
  .body :global(pre) { overflow-x: auto; padding: var(--space-3); background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-md); }
  .body :global(blockquote) { margin: var(--space-4) 0; padding-left: var(--space-3); border-left: 2px solid var(--hairline); color: var(--muted); }
</style>
