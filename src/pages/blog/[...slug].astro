---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../data/site';
import { getPosts, formatDate, readingTime, tagSlug } from '../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary} type="article" publishedTime={post.data.date} tags={post.data.tags}>
  <article>
    <p class="back"><a href={url('/blog/')}>← All posts</a></p>
    <div class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime(post.body)}</div>
    <h1>{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {post.data.tags.map((t) => <li><a class="tag" href={url(`/blog/tags/${tagSlug(t)}/`)}>{t}</a></li>)}
      </ul>
    )}
    <div class="body"><Content /></div>
  </article>
</Base>
<style>
  article { margin-top: var(--space-6); }
  .meta { color: var(--muted); font-size: 14px; margin-bottom: var(--space-2); text-align: center; }
  h1 { margin-bottom: var(--space-3); }
  .tags { list-style: none; margin: 0 0 var(--space-5); padding: 0; display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-1); }
  .tag { text-decoration: none; margin: 0; }
  .tag:hover { border-color: var(--accent); color: var(--accent); }
  .body :global(h2), .body :global(h3) { text-align: left; }
  .body :global(p), .body :global(li) { text-align: justify; text-justify: inter-word; hyphens: auto; }
  .body :global(h2) { margin: var(--space-6) 0 var(--space-3); }
  .body :global(h3) { margin: var(--space-5) 0 var(--space-2); }
  .body :global(img) { max-width: 100%; height: auto; border-radius: var(--radius-md); }
  .body :global(pre) { overflow-x: auto; padding: var(--space-3); background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-md); }
  .body :global(blockquote) { margin: var(--space-4) 0; padding-left: var(--space-3); border-left: 2px solid var(--hairline); color: var(--muted); }
</style>
