---
import Base from '../layouts/Base.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import { timeline, education, languages, beyondWork } from '../data/timeline';
---
<Base title="Biography" description="My career as a timeline: roles, awards, volunteering, research and teaching.">
  <section class="head">
    <div class="eyebrow">Biography</div>
    <h1>The story so far</h1>
    <ul class="key" aria-label="Timeline key">
      <li><span class="dot role"></span>Role</li>
      <li><span class="dot award"></span>Award</li>
      <li><span class="dot volunteer"></span>Volunteer</li>
      <li><span class="dot academic"></span>Research and teaching</li>
    </ul>
  </section>

  <section aria-label="Timeline">
    <ol class="timeline">
      {timeline.map((entry) => <TimelineEntry entry={entry} />)}
    </ol>
  </section>

  <section aria-labelledby="education">
    <h2 id="education">Education</h2>
    <dl>
      {education.map((e) => (
        <>
          <dt>{e.years}</dt>
          <dd><strong>{e.what}</strong>, {e.where}{e.link && <> · <a href={e.link.href}>{e.link.text}</a></>}</dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="languages">
    <h2 id="languages">Languages</h2>
    <p>{languages.join(', ')}</p>
  </section>

  <section aria-labelledby="beyond">
    <h2 id="beyond">Beyond work</h2>
    <p>{beyondWork}</p>
  </section>
</Base>
<style>
  .head { margin-top: var(--space-6); }
  h1 { margin: var(--space-2) 0 var(--space-3); }
  .key { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; margin: 0; padding: 0; font-size: 14px; color: var(--muted); }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: var(--space-2); background: var(--ink); }
  .dot.award { background: var(--accent); }
  .dot.volunteer { background: var(--green); }
  .dot.academic { background: var(--pink); }
  .timeline { list-style: none; margin: 0 0 0 8px; padding: 0; border-left: 2px solid var(--hairline); }
  h2 { margin-bottom: var(--space-3); }
  dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: var(--space-2) var(--space-4); }
  dt { color: var(--muted); font-size: 15px; }
  dd { margin: 0; }
  @media (max-width: 520px) { dl { grid-template-columns: 1fr; gap: 0; } dd { margin-bottom: var(--space-3); } }
</style>
