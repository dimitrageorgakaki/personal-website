---
import '@fontsource/comic-neue/700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site, url } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  profile?: boolean; // true on the home page: marks it as the author's profile page
}
const { title, description = site.description, type = 'website', publishedTime, tags = [], profile = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
if (description.length < 100) {
  // LinkedIn's Post Inspector warns about link preview descriptions under 100 characters.
  console.warn(`[link preview] Description for "${title ?? site.title}" is ${description.length} characters; aim for at least 100.`);
}

// Open Graph needs absolute URLs. Astro.site comes from the SITE variable that the deploy
// workflow sets, so these tags are only written when it is known (not on local builds).
const origin = Astro.site;
const pageUrl = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const image = origin ? new URL(url('/og-collage.jpg'), origin).href : undefined;
const imageAlt = 'AI-made collage of five portraits of Dimitra Georgakaki';

// The home page is not an article, so it has no post date of its own. Describe it as the author's
// profile page instead (schema.org ProfilePage): who the author is, when the site was published
// and when it was last built. Needs absolute URLs, so it is only written when SITE is set.
const jsonLd =
  profile && pageUrl
    ? {
        '@context': 'https://schema.org',
        '@type': 'ProfilePage',
        name: site.title,
        url: pageUrl,
        description,
        datePublished: site.launched,
        dateModified: new Date().toISOString(),
        author: { '@type': 'Person', name: site.name, url: pageUrl, sameAs: site.profiles.map((p) => p.href) },
        mainEntity: { '@type': 'Person', name: site.name, url: pageUrl, image, sameAs: site.profiles.map((p) => p.href) },
      }
    : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content={site.name} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {image && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.name} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main" class="wrap"><slot /></main>
    <footer class="wrap">
      <p>© {new Date().getFullYear()} {site.name}. Find me elsewhere:
        {site.profiles.map((p, i) => <>{i ? ' · ' : ' '}<a href={p.href} target="_blank" rel="noopener noreferrer">{p.name}</a></>)}
      </p>
    </footer>
  </body>
</html>
<style>
  footer { padding-bottom: var(--space-6); font-size: 14px; color: var(--muted); }
  footer p { margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--hairline); }
</style>
