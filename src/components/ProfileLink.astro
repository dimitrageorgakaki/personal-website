---
const { name, href, blurb } = Astro.props;
---
<a class="card" href={href} target="_blank" rel="noopener noreferrer">
  <span class="arrow" aria-hidden="true">↗</span>
  <h3>{name}</h3>
  <p>{blurb}</p>
</a>
<style>
  .card { display: block; padding: var(--space-3); background: var(--surface); border: 1px solid var(--hairline); border-radius: var(--radius-md); text-decoration: none; color: var(--ink); }
  .card:hover { box-shadow: var(--shadow-card); }
  .arrow { float: right; color: var(--accent); font-size: 18px; }
  h3 { margin-bottom: var(--space-1); }
  p { margin: 0; font-size: 14px; line-height: 21px; color: var(--muted); }
</style>
