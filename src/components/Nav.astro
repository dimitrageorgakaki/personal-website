---
import { site, url } from '../data/site';
const path = Astro.url.pathname;
const internal = [
  { href: url('/biography/'), label: 'Biography' },
  { href: url('/blog/'), label: 'Blog' },
];
const current = (href: string) => path.startsWith(href);
---
<header class="wrap">
  <nav aria-label="Main">
    <a class="name" href={url('/')}>{site.name}</a>
    <ul>
      {internal.map((l) => (
        <li><a class:list={['link', { current: current(l.href) }]} href={l.href} aria-current={current(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
      {site.profiles.map((p) => (
        <li><a class="link" href={p.href} target="_blank" rel="noopener noreferrer">{p.name} <span aria-hidden="true">↗</span><span class="sr">(opens in a new tab)</span></a></li>
      ))}
    </ul>
  </nav>
</header>
<style>
  header { padding-top: var(--space-4); }
  nav { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); padding-bottom: var(--space-3); border-bottom: 1px solid var(--hairline); }
  .name { font: 700 20px/26px var(--font-display); color: var(--ink); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .link { font-size: 15px; color: var(--muted); text-decoration: none; padding: var(--space-1) 0; }
  .link:hover { color: var(--accent); }
  .link.current { color: var(--ink); box-shadow: inset 0 -2px var(--accent); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
